{
  "name": "mafia-noir-telegram-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Production-ready групповой Telegram-бот Mafia Noir",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "pg-mem": "^3.0.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
