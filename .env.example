# Telegram — получите токен у @BotFather. Никому его не отправляйте.
BOT_TOKEN=1234567890:replace_me
BRAND_NAME=Mafia Noir
OWNER_TELEGRAM_ID=
SUPPORT_USERNAME=
PRIVACY_CONTACT=Напишите владельцу через @your_username

# PostgreSQL при запуске без Docker
DATABASE_URL=postgresql://mafia:change_this_password@127.0.0.1:5432/mafia
DATABASE_SSL=false

# Эти три значения используются Docker Compose
POSTGRES_DB=mafia
POSTGRES_USER=mafia
POSTGRES_PASSWORD=change_this_password

# Сбалансированные правила по умолчанию
MIN_PLAYERS=5
MAX_PLAYERS=30
NIGHT_SECONDS=45
DAY_SECONDS=60
NOMINATION_SECONDS=30
VOTE_SECONDS=30
LAST_WORD_SECONDS=15
BETWEEN_PHASES_SECONDS=7
REVEAL_DEAD_ROLES=true
DOCTOR_SELF_HEAL=true
COMMISSIONER_CAN_SHOOT=false
ALLOW_SELF_VOTE=false
ALLOW_SKIP_VOTE=true
NOMINATIONS_ENABLED=true
AFK_LIMIT=2
AUTO_DELETE_MESSAGES=false

# Доступные роли
ROLE_DON=true
ROLE_COMMISSAR=true
ROLE_DOCTOR=true
ROLE_MANIAC=true
ROLE_BUM=true

# Мониторинг: 0 отключает HTTP health endpoint
HEALTH_PORT=0
LOG_LEVEL=info
ASSETS_DIR=./assets

# Резервные копии scripts/backup-postgres.sh
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
